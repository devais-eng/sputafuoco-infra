      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by(namespace,pod)(rate(container_pressure_io_waiting_seconds_total{pod!=\"\",container=\"\",id=~\".*pod[^/]+[.]slice\"}[$__rate_interval]))",
