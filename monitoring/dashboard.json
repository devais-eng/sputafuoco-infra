    {
      "id": 9,
      "title": "Pressione CPU nodo (some)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max without (pod) (100 * rate(node_pressure_cpu_waiting_seconds_total[$__rate_interval]))",
          "legendFormat": "CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "PSI: percentuale di tempo in cui il lavoro resta in attesa di una risorsa. Some = almeno un task in attesa; full = tutti i task non inattivi bloccati. Non indica semplicemente quanto la risorsa è utilizzata."
    },
