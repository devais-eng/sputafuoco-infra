    {
      "id": 13,
      "title": "CPU per pod · core utilizzati",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod)(rate(container_cpu_usage_seconds_total{pod!=\"\",container!=\"\",container!=\"POD\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}} / {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "1 core = un processore logico occupato. Sputafuoco dispone di 12 processori logici. Include tutti i namespace, anche il monitoraggio."
    },
    {
      "id": 14,
      "title": "RAM per pod (working set)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 48,
