    {
      "id": 5,
      "title": "Filesystem: spazio utilizzato",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max without (pod) (node_filesystem_size_bytes{mountpoint=~\"/|/srv/data|/srv/runner-ssd\"} - node_filesystem_free_bytes{mountpoint=~\"/|/srv/data|/srv/runner-ssd\"})",
          "legendFormat": "{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "/"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Sistema · RAID1 · / (md0)"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "/srv/data"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Dati · RAID1 · /srv/data (md1p1)"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "/srv/runner-ssd"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Runner · SSD · /srv/runner-ssd (sda3)"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Tre filesystem distinti. Sistema: md0, mirror su SSD e due HDD. Dati: md1p1, mirror sui due HDD. Runner: sda3, partizione SSD dedicata e non replicata. Le capacità dei filesystem sono espresse in unità binarie; le etichette dei dischi fisici indicano la capacità commerciale."
    },
