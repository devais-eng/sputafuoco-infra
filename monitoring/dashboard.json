    },
    {
      "id": 16,
      "title": "Spazio SSD per runner · workspace e Docker",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ci_runner_volume_used_bytes",
          "legendFormat": "{{pod}} · {{volume}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* · work$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "${__field.labels.pod} · Workspace"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* · dind-storage$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "${__field.labels.pod} · Docker"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Blocchi realmente allocati, campionati ogni 120 secondi. Workspace e dati Docker sono separati. Controllare sempre età e stato della raccolta nei pannelli successivi. Nessuna quota viene imposta dalle richieste dei PVC."
    },
    {
      "id": 17,
      "title": "Età rilevamento spazio runner",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
